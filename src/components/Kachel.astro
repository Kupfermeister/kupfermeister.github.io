---
// Ohne href: Kachel ist sichtbar, aber führt (noch) nirgendwohin.
interface Props {
  href?: string;
  titel: string;
  text?: string;
  kuerzel?: string;
  farbe?: string;
  label?: string;
  nr?: string;
  status?: string;
  klein?: boolean;
}
const { href, titel, text, kuerzel, farbe, label, nr, status, klein = false } = Astro.props;
const oben = [nr, label].filter(Boolean).join(" · ");
const Tag = href ? 'a' : 'div';
---
<Tag
  class:list={['kachel', { klein, inaktiv: !href }]}
  href={href}
  style={farbe ? `--k:${farbe}` : undefined}
>
  {(nr && oben) && <span class="kachel-nr">{oben}</span>}
  <span class="kachel-kopf">
    {kuerzel && <span class="kachel-kuerzel" aria-hidden="true">{kuerzel}</span>}
    <span class="kachel-titel">{titel}</span>
  </span>
  {text && <span class="kachel-text">{text}</span>}
  {(status ?? (!nr && label)) && <span class="kachel-label">{status ?? label}</span>}
</Tag>
