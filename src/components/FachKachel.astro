---
// Große Fach-Kachel für die Startseite.
// Ganze Kachel ist klickbar (über den Titel-Link), die PDF-Links liegen darüber und bleiben eigenständig.
// Ohne href: Fach hat noch keine Themen → sichtbar, aber nicht klickbar.
import { abiturerlass } from '../design/seite';
import FachBild from './FachBild.astro';

interface Props {
  href?: string;
  titel: string;
  text?: string;
  farbe: string;
  anzahl: number;
  kerncurriculum?: string;
  fach?: string;
  erlassSeite?: number;
}
const { href, titel, text, farbe, anzahl, kerncurriculum, fach = '', erlassSeite } = Astro.props
const erlass = abiturerlass.href + (erlassSeite ? `#page=${erlassSeite}` : '');
const zaehler =
  anzahl === 0 ? 'noch keine Themen' : anzahl === 1 ? '1 Thema' : `${anzahl} Themen`;
---
<article class:list={['fach', { inaktiv: !href }]} style={`--k:${farbe}`} data-fach>
  <FachBild fach={fach} />
  <h2 class="fach-titel">
    {href ? <a href={href}>{titel}</a> : titel}
  </h2>
  <p class="fach-anzahl">{zaehler}</p>
  {text && <p class="fach-text">{text}</p>}
  <ul class="fach-links">
    {kerncurriculum && (
      <li><a href={kerncurriculum} target="_blank" rel="noopener">Kerncurriculum <span class="pdf">PDF</span></a></li>
    )}
    <li><a href={erlass} target="_blank" rel="noopener" title={`${abiturerlass.titel} (${abiturerlass.stand})`}>Abiturerlass 2028 <span class="pdf">PDF</span></a></li>
  </ul>
</article>
