---
// Hintergrundfoto einer Fach-Kachel (public/bilder/<fach>.jpg), in der Fachfarbe eingefärbt (base.css: .fach-bild).
// Quellen und Lizenzen: src/design/bilder.ts
import { bilder } from '../design/bilder';
import { url } from '../lib/inhalt';
interface Props { fach: string }
const { fach } = Astro.props;
const bild = bilder[fach];
---
{bild && (
  <div class:list={['fach-bild', { negativ: bild.negativ }]} aria-hidden="true">
    <img src={url(`bilder/${fach}.jpg`)} alt="" loading="lazy" decoding="async" style={bild.position && `object-position:${bild.position}`} />
  </div>
)}
